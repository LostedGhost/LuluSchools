# Copier en .env et renseigner les vraies valeurs. Ne jamais commiter .env.

# Base de donnees
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/luluschools

# Auth
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# FreeLLM (voir docs/adr/ADR-002-integration-llm-freellm.md)
FREELLM_BASE_URL=https://freellm-lucio.onrender.com/v1
FREELLM_API_KEY=freellmapi-your-unified-key

# Kkiapay
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# Email transactionnel - Brevo (OTP, notifications)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@luluschools.example
BREVO_SENDER_NAME=LuluSchools

# Stockage fichiers - LuluFiles (voir docs/adr/ADR-003-stockage-fichiers-lulufiles.md)
# Tout document SAUF le casier judiciaire, qui reste local pour raisons legales (Art. 395)
LULUFILES_BASE_URL=https://lulufiles-api.onrender.com
LULUFILES_API_KEY=lf_live_your_key

# Stockage local restreint (casier judiciaire uniquement)
# Chemin de production (VPS Linux). En dev sous Windows, utiliser un chemin Windows
# explicite (ex. D:/lulu-dev-data/casier-judiciaire) : un chemin absolu style Linux
# est mal interprete par pathlib sous Windows (cree sous la racine du lecteur courant).
CASIER_JUDICIAIRE_STORAGE_PATH=/var/lib/luluschools/casier-judiciaire

# CORS - domaines autorises a appeler l'API depuis un navigateur (liste JSON)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Divers
ENVIRONMENT=development
